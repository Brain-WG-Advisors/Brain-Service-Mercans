filters:
  and:
    - file.inFolder("paises")
    - tipo == "pais"
formulas:
  Research: if(etapa_research == "concluida", "✅", if(etapa_research == "em andamento", "🔄", if(etapa_research == "aguardando", "⏳", "")))
  Design: if(etapa_design == "concluida", "✅", if(etapa_design == "em andamento", "🔄", if(etapa_design == "aguardando", "⏳", "")))
  Suporte: if(tickets_abertos > 0, "🔄 " + tickets_abertos + " aberto(s)", if(tickets_abertos == 0, "✅", ""))
properties:
  file.name:
    displayName: País
  note.ccg:
    displayName: CCG
  note.wtc:
    displayName: WTC
  note.dd:
    displayName: DD
  note.report_specs:
    displayName: Report Specs
  note.sir:
    displayName: SIR
views:
  - type: table
    name: Resumo
    order:
      - file.name
      - formula.Research
      - formula.Design
      - formula.Suporte
    sort:
      - property: tickets_abertos
        direction: DESC
  - type: table
    name: Artefatos
    order:
      - file.name
      - ccg
      - wtc
      - dd
      - report_specs
      - sir
      - payslip
      - obs_versoes
