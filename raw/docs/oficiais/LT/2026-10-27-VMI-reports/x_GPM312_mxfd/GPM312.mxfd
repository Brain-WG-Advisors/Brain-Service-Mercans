					'if metai&gt;=2020 and (fieldsGPM312L.Itembyname("L5-"&amp;j).value = "01" or fieldsGPM312L.Itembyname("L5-"&amp;j).value = "04") and fieldsGPM312L.Itembyname("L9-"&amp;j).todecimal = 0 and fieldsGPM312L.Itembyname("L9-"&amp;j).value &lt;&gt;"" and not isfilled(fieldsGPM312L.Itembyname("L13-"&amp;j)) then
					if metai&gt;=2020 and (fieldsGPM312L.Itembyname("L5-"&amp;j).value = "01" or fieldsGPM312L.Itembyname("L5-"&amp;j).value = "03" or fieldsGPM312L.Itembyname("L5-"&amp;j).value = "04") and fieldsGPM312L.Itembyname("L9-"&amp;j).todecimal = 0 and fieldsGPM312L.Itembyname("L9-"&amp;j).value &lt;&gt;"" and not isfilled(fieldsGPM312L.Itembyname("L13-"&amp;j)) then
						form.seterror"L13 laukelyje nurodykite užsienio valstybėje (L12 laukelis) sumokėtą GPM ar jam tapataus mokesčio sumą. Jei mokestis nebuvo mokėtas L13 laukelyje įrašomas nulis.", array(fieldsGPM312L.Itembyname("L13-"&amp;j)),el_error
					end if
				else
					tmp = true
				end if
				if tmp = true then
					if fieldsGPM312L.Itembyname("L13-"&amp;j).todecimal &gt; 0 then
						form.seterror"L13 laukelis gali būti pildomas tik dėl užsienio valstybėje išmokėtų išmokų.", array(fieldsGPM312L.Itembyname("L13-"&amp;j))
					end if
				end if
				
				If metai &gt;= 2020 and fieldsGPM312L.ItemByName("L1-"&amp;j).Value &lt;&gt; "" and fieldsGPM312L.ItemByName("L5-"&amp;j).Value &lt;&gt; "" and fieldsGPM312L.ItemByName("L7-"&amp;j).Value = "M" Then
					If L5_Ne_Is_L7_M_Saraso(fieldsGPM312L.ItemByName("L5-"&amp;j)) = False Then
						
						'Form.SetError "   ork eilutė j = " &amp; cStr(j)
						'Form.SetError "      ork L1_L8.Exists(L1)=" &amp; cStr(L1_L8.Exists(fieldsGPM312L.ItemByName("L1-"&amp;j).Value))
						
						If Not L1_L8.Exists(fieldsGPM312L.ItemByName("L1-"&amp;j).Value) Then
							'Form.SetError "         ork key Not exist šaka"
							L1_L8.Add fieldsGPM312L.ItemByName("L1-"&amp;j).Value, fieldsGPM312L.ItemByName("L8-"&amp;j).ToDecimal
							'Form.SetError "         ork   add key L1=" &amp; fieldsGPM312L.ItemByName("L1-"&amp;j).Value &amp; " and value L8=" &amp; fieldsGPM312L.ItemByName("L8-"&amp;j).Value
						else
							'Form.SetError "         ork key exist šaka"
							tmp = CCur(L1_L8.Item(fieldsGPM312L.ItemByName("L1-"&amp;j).Value))
							'Form.SetError "         ork   item = " &amp; cStr(tmp)
							tmp = tmp + fieldsGPM312L.ItemByName("L8-"&amp;j).ToDecimal
							'Form.SetError "         ork   new tmp = " &amp; cStr(tmp)
							L1_L8.Item(fieldsGPM312L.ItemByName("L1-"&amp;j).Value) = tmp
							'Form.SetError "         ork   key L1=" &amp; fieldsGPM312L.ItemByName("L1-"&amp;j).Value &amp; " and new value L8=" &amp; cStr(L1_L8.Item(fieldsGPM312L.ItemByName("L1-"&amp;j).Value))
						End If
					End If
				End If
				
				'L7 P C
				'If metai &gt;= 2025 Then
				'	If fieldsGPM312L.ItemByName("L5-"&amp;j).value &lt;&gt; "" and fieldsGPM312L.ItemByName("L5-"&amp;j).value &lt;&gt; "23" and fieldsGPM312L.ItemByName("L7-"&amp;j).value &lt;&gt; "P" Then
				'		Form.SetError "L7 laukelyje nurodyti ""P"" galima tik žemės nuomos išmokoms deklaruoti", Array(fieldsGPM312L.ItemByName("L5-"&amp;j), fieldsGPM312L.ItemByName("L7-"&amp;j))
				'	End If
				'	If fieldsGPM312L.ItemByName("L5-"&amp;j).value &lt;&gt; "" and fieldsGPM312L.ItemByName("L5-"&amp;j).value &lt;&gt; "42" and fieldsGPM312L.ItemByName("L7-"&amp;j).value &lt;&gt; "C" Then
				'		Form.SetError "L7 laukelyje nurodyti ""C"" galima tik lošimus organizuojančioms bendrovėms sumokėtoms lošimų įmokoms deklaruoti", Array(fieldsGPM312L.ItemByName("L5-"&amp;j), fieldsGPM312L.ItemByName("L7-"&amp;j))
				'	End If 
				'End If
				
			'Laikinai atsisakyta dublių gaudymo
			'	'Su L3
			'	tmp = Trim(fieldsGPM312L.ItemByName("L1-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L2-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L3-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L4-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L5-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L6-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L7-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L8-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L9-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L10-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L11-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L12-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L13-"&amp;j).Value)
			'	'Be L3
			'	tmp_2  = Trim(fieldsGPM312L.ItemByName("L1-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L2-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L4-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L5-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L6-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L7-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L8-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L9-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L10-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L11-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L12-"&amp;j).Value &amp; fieldsGPM312L.ItemByName("L13-"&amp;j).Value)
			'	If tmp &lt;&gt; "" Then
			'		If Not L_Dublis.Exists(tmp_2) Then
			'			L_Dublis.Add tmp_2, "1"
			'		else
			'			L_Dublis.Item(tmp_2) = cStr((CLng(L_Dublis.Item(tmp_2)) + 1) )
			'			Form.SetError "Užpildėte tokius pačius duomenis antrą kartą. Tam pačiam asmeniui išmokėtos tos pačios klasės, rūšies ir vienodu tarifu apmokestintos išmokos deklaruojamos vienoje eilutėje.", Array(fieldsGPM312L.ItemByName("L1-"&amp;j), fieldsGPM312L.ItemByName("L2-"&amp;j), fieldsGPM312L.ItemByName("L3-"&amp;j), fieldsGPM312L.ItemByName("L4-"&amp;j), fieldsGPM312L.ItemByName("L5-"&amp;j), fieldsGPM312L.ItemByName("L6-"&amp;j), fieldsGPM312L.ItemByName("L7-"&amp;j), fieldsGPM312L.ItemByName("L8-"&amp;j), fieldsGPM312L.ItemByName("L9-"&amp;j), fieldsGPM312L.ItemByName("L10-"&amp;j), fieldsGPM312L.ItemByName("L11-"&amp;j), fieldsGPM312L.ItemByName("L12-"&amp;j), fieldsGPM312L.ItemByName("L13-"&amp;j) )
			'			
			'			If Not L_Dublis_1.Exists(tmp_2) Then
			'				L_Dublis_1.Add tmp_2, "2"
			'			else
			'				L_Dublis_1.Item(tmp_2) = cStr((CLng(L_Dublis_1.Item(tmp_2)) + 1) )
			'			End If
			'		End If
			'	End If
				
			next
			if b2=true then form.seterror "Pasitikrinkite L1 laukelyje įrašytą asmens kodą", m1,el_warning
			if b5_7=true then form.seterror "L5 laukelyje pasirinkus 07 pajamų rūšies kodą, L8 laukelyje įrašyta išmokos suma neturi viršyti 200 Eur. Viršijanti 200 Eur prizų ir dovanų suma iš darbdavio yra apmokestinama ir deklaruojama 01 kodu.", m5_7,el_warning
			If b6 = True Then Form.SetError "PASITIKRINKITE IŠMOKAS NATŪRA. Jei išmokėjote pinigais, L6 laukelis turi būti neužpildytas.", m6, El_Warning
			'if b7 then form.seterror "Jei L8 laukelyje nurodyta išmoka išmokėta darbdavio, L7 laukelyje turi būti pasirenkama ""D-individualios veiklos išmoka, išmokėta įdarbintam asmeniui""", m7,el_warning
			if b7 then form.seterror "Jei L8 laukelyje nurodyta individualios veiklos išmoka išmokėta darbdavio, L7 laukelyje turi būti pasirenkama ""D"".", m7,el_warning
			if b8=true then form.seterror"L8 laukelyje deklaruojama išmokų suma lygi arba mažesnė už L10 ir L11 laukeliuose įrašytą mokesčio sumą", m8, el_warning
			if b8_1=true then form.seterror"L8 laukelyje deklaruotos neapmokestinamos pajamos. Pasitikrinkite ar teisingai nurodyta GPM suma L10 ir/ar L11 laukeliuose.", m8_1,el_warning
			if b9_0=true then form.seterror"L9 laukelyje turi būti įrašomas 0, jei L8 laukelyje įrašytos pajamų mokesčiu neapmokestinamos  sumos. Pasitikrinkite deklaruotas sumas.", m9_0, el_warning
			if b9_1=true then form.seterror"Nurodyta GPM suma (L10+L11) nelygi GPM sumai, apskaičiuotai pagal išmokos sumą (L8) ir pasirinktą GPM tarifą (L9). Skirtingais GPM tarifais apmokestinamos tos pačios klasės ir rūšies išmokos deklaruojamos atskirose eilutėse. Pasitikrinkite sumas.", m9_1, el_warning
			if b9=true and fieldsGPM312L.Itembyname("B_ML_Metai").todecimal = 2018 then 
				form.seterror "L9 laukelyje nepasirinktas GPM tarifas", m9,el_warning
			elseif b9=true and fieldsGPM312L.Itembyname("B_ML_Metai").todecimal &gt;= 2019 then 
				'form.seterror "L9 laukelyje nepasirinktas GPM tarifas", m9,el_error
			end if
			'if b9_10_12=true then form.seterror "L9 laukelyje nurodytas neteisingas GPM tarifas, kai L12 nurodytas kodas užsienio valstybės, kuriai sumokėtas GPM", m9_10_12,el_error
			if b9_10_12=true then form.seterror "Kai L12 laukelyje nurodytas kodas užsienio valstybės, kuriai sumokėtas pajamų mokestis, laukeliuose L9, L10 ir L11 negali būti daugiau už 0.", m9_10_12,el_error
			'if b9_5_12=true then form.seterror "L9 laukelyje 0 proc. GPM tarifas taikomas tik išmokoms, atleidžiamoms nuo GPM pagal GPMĮ 37 straipsnį", m9_5_12,el_warning
			If b9_5_12 = true Then Form.SetError "L9 laukelyje 0 proc. GPM tarifas taikomas tik išmokoms, atleidžiamoms nuo GPM pagal GPMĮ 37 straipsnį", m9_5_12, El_Warning
			'if b9_12=true then form.seterror "L9 laukelyje nurodytas neteisingas GPM tarifas", m9_12,el_warning
			if b9_10=true then form.seterror "L9 laukelyje nurodytas neteisingas GPM tarifas", m9_10,el_error
			if b9_5=true then form.seterror "L9 laukelyje nurodytas neteisingas GPM tarifas", m9_5,el_warning
			if b11=true then form.seterror "Pasitikrinkite, ar L11 laukelyje nurodoma išmokas išmokėjusio asmens iš savo lėšų sumokėta GPM suma. Išskaičiuota ir į biudžetą sumokėta GPM suma nurodoma tik L10 laukelyje.", m11,el_warning
			if b10_11=true then form.seterror "L10 ir L11 laukeliuose nurodyta sudvigubinta GPM suma. Išskaičiuota ir į biudžetą sumokėta GPM suma nurodoma tik L10 laukelyje, L11 laukelyje nurodoma išmokas išmokėjusio asmens iš savo lėšų sumokėta GPM suma.", m10_11,el_error
		next
	end if
	' kratom L1_L8
	If L1_L8.Count &gt; 0 Then
		tmp = L1_L8.Keys
		For Each k in tmp
			If CCur(L1_L8.Item(k)) &gt; 100000 Then
				
				ReDim tmp_2(0)
				For i = 1 To pagesGPM312L.Count
					Set fieldsGPM312L = pagesGPM312L.Item(i).Fields
					
					for j = 1 to 10
						If fieldsGPM312L.ItemByName("L1-"&amp;j).Value = k Then
							If metai &gt;= 2020 and fieldsGPM312L.ItemByName("L1-"&amp;j).Value &lt;&gt; "" and fieldsGPM312L.ItemByName("L5-"&amp;j).Value &lt;&gt; "" and fieldsGPM312L.ItemByName("L7-"&amp;j).Value = "M" Then
								If L5_Ne_Is_L7_M_Saraso(fieldsGPM312L.ItemByName("L5-"&amp;j)) = False Then
									'reikia masyvo, kur 0 stulpelis = L1, o 1 stulpelis = L7 ir 2 stulpelis = L8
									
									If Ubound(tmp_2) &lt; 2 Then
										ReDim Preserve tmp_2(2)
									else
										ReDim Preserve tmp_2(Ubound(tmp_2) + 3)
									End If
									
									Set tmp_2(Ubound(tmp_2) - 2) = fieldsGPM312L.ItemByName("L1-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 1) = fieldsGPM312L.ItemByName("L7-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 0) = fieldsGPM312L.ItemByName("L8-"&amp;j)
								End If
							End If
						End If
					Next
				Next
				
				Form.SetError "Bendra pagal mažosios bendrijos nario su mažąja bendrija sudarytas civilines sutartis suteiktų paslaugų ir darbų suma, išmokėta po 2020-11-19, negali viršyti 100 000 eurų per kalendorinius metus. Viršyta suma deklaruojama 02 ar 26 pajamų rūšies kodais.", tmp_2
			End If
		Next
	End If
	
'Laikinai atsisakyta dublių gaudymo
'	Dim arrayKeys
'	arrayKeys = L_Dublis_1.Keys
'	for i = 0 to L_Dublis_1.Count -1
'		'Response.Write ( "&lt;br&gt;Key =" arrayKeys(i) "nbsp;Item = " _ L_Dublis_1.Item(arrayKeys(i)) )
'		If L_Dublis_1.Item(arrayKeys(i)) = 1 Then
'			L_Dublis_1.Remove(arrayKeys(i))
'		End If
'	next
'	arrayKeys = L_Dublis_1.Keys
'	for i = 0 to L_Dublis_1.Count -1
'		Form.SetError "   ork key = !"&amp; arrayKeys(i) &amp;"! kartojas "&amp; L_Dublis_1.Item(arrayKeys(i)) &amp; " kartų."
'	next
	
end sub

sub GPM312U
	dim pagesGPM312,fieldsGPM312
	dim pagesGPM312L,fieldsGPM312L
	dim pagesGPM312U,fieldsGPM312U
	dim i, j, k, metai
	dim tmp, tmp_2, tmp_3
	Dim b2,m1,b,m,b9,m9,b11,m11,b9_5,m9_5,b9_10,m9_10,b9_12,m9_12,b10_11,m10_11,b8,m8,b8_1,m8_1,b9_0,m9_0,b9_1,m9_1
	dim b5_7, m5_7, b7,m7
	Dim b6, m6
	
	Set pagesGPM312 = Form.GetPagesForTemplate("GPM312")
	Set fieldsGPM312 = pagesGPM312.Item(1).Fields
	Set pagesGPM312L = Form.GetPagesForTemplate("GPM312L")
	Set pagesGPM312U = Form.GetPagesForTemplate("GPM312U")
	
	metai = fieldsGPM312.Itembyname("B_ML_Metai").todecimal
	
	Dim U1_U8
	Set U1_U8 = CreateObject("Scripting.Dictionary")
	Dim U13_U8
	Set U13_U8 = CreateObject("Scripting.Dictionary")
	Dim U_Dublis
	Set U_Dublis = CreateObject("Scripting.Dictionary")
	Dim U_Dublis_1
	Set U_Dublis_1 = CreateObject("Scripting.Dictionary")
	
	if pagesGPM312U.Count &gt; 0 then
		form.seterror "ES valstybių asmenų identifikacinius numerius (kodus), jų algoritmą galima pasitikrinti Europos komisijos puslapyje: http://ec.europa.eu/taxation_customs/tin/tinByCountry.html, http://ec.europa.eu/taxation_customs/tin/tinRequest.html", array(Form.GetPagesForTemplate("GPM312U").Item(1).Fields.Itembyname("B_FormNr")), El_Warning
		
		For i = 1 To pagesGPM312U.Count
			b6 = False
			m6 = Array()
			b=false
			b2=false
			b9=false
			m=array()
			m1=array()
			b7=false
			m7=array()
			b5_7=false
			m5_7=array()
			b8=false
			m8=array()
			b8_1=false
			m8_1=array()
			b9_0=false
			m9_0=array()
			b9_1=false
			m9_1=array()
			m9=array()
			b9_5=false
			m9_5=array()
			b9_10=false
			m9_10=array()
			b9_12=false
			m9_12=array()
			b11=false
			m11=array()
			b10_11=false
			m10_11=array()
			
			Set fieldsGPM312U = pagesGPM312U.Item(i).Fields
			
			fieldsGPM312U.Itembyname("LapoNr").setcheckvalue Cstr(i)
			
			fieldsGPM312U.Itembyname("B_MM_ID").setcheckvalue cstr(fieldsGPM312.Itembyname("B_MM_ID").value)
			fieldsGPM312U.Itembyname("B_ML_Metai").setcheckvalue cstr(fieldsGPM312.Itembyname("B_ML_Metai").value)
			
			for j = 1 to 5
				if fieldsGPM312U.Itembyname("U1-"&amp;j).Value &lt;&gt; "" then
					tmp_3 = Replace(Trim(fieldsGPM312U.Itembyname("U1-"&amp;j).Value), "  ", " ")
					While InStr(tmp_3, "  ") &gt; 0
						tmp_3 = Replace(tmp_3, "  ", " ")
					WEnd
					fieldsGPM312U.Itembyname("U1-"&amp;j).SetCheckValue cStr(tmp_3)
				end if
				if fieldsGPM312U.Itembyname("U3-"&amp;j).Value &lt;&gt; "" then
					tmp_3 = Replace(Trim(fieldsGPM312U.Itembyname("U3-"&amp;j).Value), "  ", " ")
					While InStr(tmp_3, "  ") &gt; 0
						tmp_3 = Replace(tmp_3, "  ", " ")
					WEnd
					fieldsGPM312U.Itembyname("U3-"&amp;j).SetCheckValue cStr(tmp_3)
				end if
				if fieldsGPM312U.Itembyname("U15-"&amp;j).Value &lt;&gt; "" then
					tmp_3 = Replace(Trim(fieldsGPM312U.Itembyname("U15-"&amp;j).Value), "  ", " ")
					While InStr(tmp_3, "  ") &gt; 0
						tmp_3 = Replace(tmp_3, "  ", " ")
					WEnd
					fieldsGPM312U.Itembyname("U15-"&amp;j).SetCheckValue cStr(tmp_3)
				end if
				
				tmp = false
				if isfilled(fieldsGPM312U.Itembyname("U14-"&amp;j)) then
					if fieldsGPM312U.Itembyname("U14-"&amp;j).value = "LT" then
						tmp = true
					end if
				else
					tmp = true
				end if
				if tmp = false then
					if isfilled(fieldsGPM312U.Itembyname("U14-"&amp;j)) then
						if fieldsGPM312U.Itembyname("U14-"&amp;j).value &lt;&gt; "LT" then
							if fieldsGPM312U.Itembyname("U1-"&amp;j).value = "" then
								'form.seterror"Jei žinote išmokų gavėjo identifikacinį numerį (kodą), suteiktą Lietuvoje - įrašykite jį į U1 laukelį.", array(fieldsGPM312U.Itembyname("U1-"&amp;j)),el_warning
							end if
						end if
					end if
				end if
				
				tmp = false
				tmp_2 = false
				if fieldsGPM312U.Itembyname("U2-"&amp;j).todecimal = 1 and isfilled(fieldsGPM312U.Itembyname("U1-"&amp;j)) then
					if len(fieldsGPM312U.Itembyname("U1-"&amp;j).value) &lt;&gt; 10 and len(fieldsGPM312U.Itembyname("U1-"&amp;j).value) &lt;&gt; 11 then tmp_2 = true
					if len(fieldsGPM312U.Itembyname("U1-"&amp;j).value) = 10 then
						tmp =  TIN_tikrinimas (fieldsGPM312U.Itembyname("U1-"&amp;j), "U1 laukelyje nurodytas neteisingas asmens kodas arba VMI suteiktas mokėtojo numeris")
					end if
					if not isnumeric(fieldsGPM312U.Itembyname("U1-"&amp;j).value) then tmp_2 = true
				end if
				if tmp = false and tmp_2 = true then form.seterror"U1 laukelyje nurodytas neteisingas asmens kodas arba VMI suteiktas mokėtojo numeris", array(fieldsGPM312U.Itembyname("U1-"&amp;j))
				
				if fieldsGPM312U.Itembyname("U2-"&amp;j).todecimal = 1 and isfilled(fieldsGPM312U.Itembyname("U1-"&amp;j)) then
					if len(fieldsGPM312U.Itembyname("U1-"&amp;j).value) = 11 then
						tmp =  AK_tikrinimas (fieldsGPM312U.Itembyname("U1-"&amp;j).value, fieldsGPM312U.Itembyname("U1-"&amp;j), "Pasitikrinkite U1 laukelyje įrašytą asmens kodą")
						if tmp then 
							Redim Preserve m1(Ubound(m1)+1)
							set m1(Ubound(m1))=fieldsGPM312U.Itembyname("U1-"&amp;j)
							b2=true
						end if
					end if
				end if
				
				if fieldsGPM312U.Itembyname("U2-"&amp;j).todecimal = 2 then
					if isfilled(fieldsGPM312U.Itembyname("U1-"&amp;j)) then
						tmp = false
						tmp = verslo_nr(trim(cstr(fieldsGPM312U.Itembyname("U1-"&amp;j).value)))
						if tmp = false then
						'	form.seterror"U1 laukelyje nurodytas neteisingas verslo liudijimo numeris", array(fieldsGPM312U.Itembyname("U1-"&amp;j))
							form.seterror"U1 laukelyje nurodytas neteisingas verslo liudijimo numeris. Pasitikrinkite, verslo liudijime po brūkšnelio įrašytas versijos numeris nepildomas.", array(fieldsGPM312U.Itembyname("U1-"&amp;j))
						end if
					end if
				end if
				
				if fieldsGPM312U.Itembyname("U2-"&amp;j).todecimal = 3 then
