dim b5
b5=false
' This function starts execution of the script
Sub Main()
	Form.SetDefaultDecimalSeparator ","
	Form.SetDefaultDateFormat DF_YearMonthDay, YL_FourDigits, "-"
		
	If CheckVersion = False Then
        	Exit Sub
        End If
	
	GPM312
	GPM312L
	GPM312U
	if b5 then form.seterror "Iki 2018 m. gruodžio 31 d. apskaičiuotos su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos, išmokėtos 2019 metais ir vėlesniais mokestiniais laikotarpiais, apmokestinamos 15 proc. GPM tarifu", array(),el_warning
End Sub

Sub onInit()
	'Add your code here
	Form.SetOnChangedHandler "OnFieldEvent", "GPM312", "B_ML_Metai"
End Sub

Sub OnAddPage(PageName,PageIndex)
	If PageName ="GPM312L" or PageName ="GPM312U" Then
		OnFieldEvent
	End if
End Sub

Sub OnFieldEvent
	Form.SetDefaultDecimalSeparator ","
	Form.SetDefaultDateFormat DF_YearMonthDay, YL_FourDigits, "-"
	
	Dim pagesGPM312, pagesGPM312L, pagesGPM312U
	Dim fieldsGPM312, fieldsGPM312L, fieldsGPM312U
	
	Dim tipas, kodas,  i, ii, j, fields, l_kodas
	Dim laikotarpis
	Dim pajamos, ismokos_6, ismokos_7, ismokos_7_U, tarifai_L9, tarifai_U9, tarifai_U7
	
	set pagesGPM312 = Form.GetPagesForTemplate("GPM312")
	Set fieldsGPM312 = pagesGPM312.Item( 1 ).Fields
	set laikotarpis = fieldsGPM312.ItemByName("B_ML_Metai")
	
	if laikotarpis.todecimal = 2018 then
		ReDim pajamos(72)
		
		pajamos(0)   = "1.Su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos:"
		pajamos(1)   = "01;Su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos, išskyrus žymimas 08 kodu (iki 2018-12-31)"
		pajamos(2)   = "02;Neribotos civilinės atsakomybės vieneto savo dalyviui ar MB savo nariui išmokėtos išmokos, pagal GPMĮ 2 str. 34 dalį priskiriamos su darbo santykiais ar jų esmę atitinkančiais santykiais susijusioms pajamoms"
		pajamos(3)   = "03;Ligos, motinystės, tėvystės, vaiko priežiūros ir ilgalaikio darbo išmokos"
		pajamos(4)   = "05;Dienpinigiai, išmokėti į komandiruotę išsiųstiems darbuotojams Komandiruočių sąnaudų atskaitymo iš pajamų taisyklių, patvirtintų LR Vyriausybės 2003 m. sausio 28 d. nutarimo Nr. 99 „Dėl komandiruočių sąnaudų atskaitymo iš pajamų taisyklių patvirtinimo“ nustatyta tvarka"
		pajamos(5)   = "06;LR darbo kodekso nustatyta tvarka išmokėtos padidėjusių išlaidų  kompensacijos darbuotojams, kurių darbas yra kilnojamojo pobūdžio arba susijęs su kelionėmis ar važiavimu"
		pajamos(6)   = "07;Asmens, susijusio su gyventoju darbo santykiais ar jų esmę atitinkančiais santykiais, išmokėtų prizų ir dovanų vertė, per mokestinį laikotarpį neviršijanti 200 eurų"
		pajamos(7)   = "08;Jūrininkui už darbą laivo, įregistruoto EEE jūrų laivų registre, reiso metu išmokėtos išmokos (iki 2018-12-31)"
