def filing(fid, authority, frequency, fmt, rids, ccg, note=None):
    d = {"filing_id": fid, "authority": authority, "frequency": frequency, "format": fmt,
         "integration_type": "outbound", "product_mapping_required": True,
         "channel": PROVIDER, "register_ids": rids, "ccg_location": ccg}
