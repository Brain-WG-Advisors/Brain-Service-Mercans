' Copyright (c) ABBYY Software House, 2003. All rights reserved.
'----------------------------------------------------------------------
Function IsDigit(s)
	Dim r, m, w
	
	Set r = New RegExp
	r.Pattern = "^[0-9]*$"
	Set m = r.Execute(s)
	
	If m.Count = 0 Then
		IsDigit = False
	Else
		IsDigit = True
	End If
	
	Set w = Nothing
	Set r = Nothing
End Function

Function IsAlpha(s)
	Dim r, m, w
	
	Set r = New RegExp
	r.Pattern = "^[A-Za-z]*$"
	Set m = r.Execute(s)
	
	If m.Count = 0 Then
		IsAlpha = False
	Else
		IsAlpha = True
	End If
	
	Set w = Nothing
	Set r = Nothing
End Function

Function verslo_nr(reiksme)
	dim tmp, tmp_2, strngs
	
	tmp = true
	tmp_2 = true
	strngs = ""
	
	if len(reiksme) = 8 then
		strngs = mid(reiksme,1,1)
		tmp = IsAlpha(trim(cstr(strngs)))
		if tmp then
			strngs = ""
			strngs = mid(reiksme,2,1)
			tmp = IsAlpha(trim(cstr(strngs)))
			tmp_2 = IsDigit(trim(cstr(strngs)))
			if tmp or tmp_2 then
				tmp = true
				strngs = ""
				strngs = mid(reiksme,3,6)
				tmp_2 = IsDigit(trim(cstr(strngs)))
				if tmp_2 then
				else
					tmp = false
				end if
			else
				tmp = false
			end if
			
		else
			tmp = false
		end if
	else
		tmp = false
	end if
	verslo_nr = tmp
end function

Function IVPN(kodas) 'individualios veiklos pazymos numeris
	dim tmp, tmp_2, strngs, reiksme
	'kodas.setcheckValue trim(kodas.value)
	kodas.SetCheckValue Replace(kodas.value, " ", "")
	
	tmp = true
	tmp_2 = true
	strngs = ""
	reiksme=kodas.value
	if len(reiksme) = 6 then
		strngs = mid(reiksme,1,6)
		tmp_2 = IsDigit(trim(cstr(strngs)))
		if not tmp_2 then
			tmp = false
		end if
		'ork
		'buvo įrašyta 128-15 ir todėl CLng(strngs) luždavo
		'If tmp_2 = True and CLng(strngs) = 0 Then
		If tmp_2 = True Then
			If CLng(strngs) = 0 Then
				tmp = false
			End If
		End If
	else
		if len(reiksme) = 7 then
			strngs = mid(reiksme,1,7)
			tmp_2 = IsDigit(trim(cstr(strngs)))
			if not tmp_2 then
				tmp = false
			end if
			'ork
			'If tmp_2 = True and CLng(strngs) &lt; 1000001 Then
			If tmp_2 = True Then
				If CLng(strngs) &lt; 1000001 Then
					tmp = false
				End If
			End If
		else
			tmp = false
		End If
	end if
	IVPN = tmp
end function

Function PVM_kodas(reiksme)
	dim tmp, tmp_2, strngs
	
	tmp = true
	tmp_2 = true
	strngs = ""
	
	if len(reiksme) = 14 then
		strngs = mid(reiksme,1,2)
		if cstr(strngs) = "LT" then
			strngs = ""
			strngs = mid(reiksme,3,12)
			tmp_2 = IsDigit(trim(cstr(strngs)))
			if tmp_2 then
				strngs = ""
				strngs = mid(reiksme,13,1)
				if cstr(strngs) = "1" then
				else
					tmp = false
				end if
			else
				tmp = false
			end if
		else
			tmp = false
		end if
	else
		tmp = false
	end if
	
	PVM_kodas = tmp
end function

Function IsFilled(fieldlink)
	IsFilled = true
	if fieldlink.value = "" then 
		IsFilled = false
	end if
End Function

Function TIN_tikrinimas (kodas, klaida)
	dim suma, i, suma1
	
	TIN_tikrinimas = false
	
	'ork
	If IsDigit(trim(cstr(kodas.Value))) = True Then
		Select Case Len(kodas.ToDecimal)
			case 10
				suma = 0
				
				For i = 1 to 9
					suma = suma + CInt(Mid(Left(kodas.Value,9), i, 1)) * (10-i)
				Next
				
				suma = suma mod CInt(Left(kodas.Value,2))
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If CInt(Right(kodas.Value,1)) &lt;&gt; suma Then
				'	Form.SetError klaida, Array(pagesPLN204_1.Item( 1 ).Fields.ItemByName( "B_MM_ID" ) )
					Form.SetError klaida, Array(kodas)
					TIN_tikrinimas = true
				End If
			case else
				'Form.SetError klaida, Array(kodas)
		End Select
	End If
end function

function AK_tikrinimas(reiksme, nuoroda, klaida)
	dim suma, stabdis, i, GimD, suma1
	
	AK_tikrinimas = false
	
	'ork
	'if isNumeric(reiksme) = true then
	'3850116010	'	suvesti 10 asmens kodo ženklų ir 11 ženklas yra Tab. Len gražins ilgis = 11, o isNumeris garažins True.
	If IsDigit(trim(cstr(reiksme))) = True Then
		Select Case Len(reiksme)
			case 11
				If Left(reiksme, 1) &lt;&gt; 9 Then
					stabdis = 0
					If Left(reiksme, 1) &lt;&gt; "1" and Left(reiksme, 1) &lt;&gt; "2" and Left(reiksme, 1) &lt;&gt; "3" and Left(reiksme, 1) &lt;&gt; "4" and Left(reiksme, 1) &lt;&gt; "5" and Left(reiksme, 1) &lt;&gt; "6" Then
						stabdis = 1
						'Form.SetError klaida, Array(nuoroda), el_warning
						AK_tikrinimas = true
					End If
					Select case Left(reiksme, 1)
						case "1", "2"
							GimD = "18" &amp; Mid(reiksme, 2, 2) &amp; "-" &amp; Mid(reiksme, 4, 2) &amp; "-" &amp; Mid(reiksme, 6, 2)
						case "3", "4"
							GimD = "19" &amp; Mid(reiksme, 2, 2) &amp; "-" &amp; Mid(reiksme, 4, 2) &amp; "-" &amp; Mid(reiksme, 6, 2)
						case "5", "6"
							GimD = "20" &amp; Mid(reiksme, 2, 2) &amp; "-" &amp; Mid(reiksme, 4, 2) &amp; "-" &amp; Mid(reiksme, 6, 2)
					End Select
					If stabdis = 0 Then
						If Not IsDate(GimD) Then
							stabdis = 1
							'Form.SetError klaida, Array(nuoroda), el_warning
							AK_tikrinimas = true
						End If
					End If
					suma = 0
					For i = 1 To 9
						suma = suma + (CLng(Mid(reiksme, i, 1)) ) * i
					Next
					suma = suma + CLng(Mid(reiksme, 10, 1))
					suma = suma Mod 11
					
					If suma &gt;= 10 Then
						suma = 0
						For i = 3 to 9
							suma = suma + (CLng(Mid(reiksme, i-2, 1)) ) * i
						Next
						For i = 1 to 3
							suma = suma + (CLng(Mid(reiksme, i+7, 1)) ) * i
						Next
						suma = suma Mod 11
					End If
					If suma = 10 Then suma = 0
					If stabdis = 0 Then
						If suma &lt;&gt; CLng(Mid(reiksme, 11, 1)) Then 
							stabdis = 1
							'Form.SetError klaida, Array(nuoroda), el_warning
							AK_tikrinimas = true
						End If
					End If
				else
					stabdis = 0
					suma = 0
					For i = 1 To 9
						suma = suma + (CLng(Mid(reiksme, i, 1)) ) * i
					Next
					suma = suma + CLng(Mid(reiksme, 10, 1))
					suma = suma Mod 11
					
					If suma &gt;= 10 Then
						suma = 0
						For i = 3 to 9
							suma = suma + (CLng(Mid(reiksme, i-2, 1)) ) * i
						Next
						For i = 1 to 3
							suma = suma + (CLng(Mid(reiksme, i+7, 1)) ) * i
						Next
						suma = suma Mod 11
					End If
					If suma = 10 Then suma = 0
					If stabdis = 0 Then
						If suma &lt;&gt; CLng(Mid(reiksme, 11, 1)) Then 
							stabdis = 1
							'Form.SetError klaida, Array(nuoroda)
							AK_tikrinimas = true
						End If
					End If
				End If
		End Select
	else
		AK_tikrinimas = true
	end if
End function

Function JAR_tikrinimas (kodas, klaida)
	dim suma, i, suma1
	dim rt
	
	rt=true
	'ork
	If IsDigit(trim(cstr(kodas.Value))) = True Then
		Select Case Len(kodas.ToDecimal)
			case 9
				suma = 0
				
				For i = 1 to 8
					suma = suma + CInt(Mid(Left(kodas.Value, 8), i, 1)) * i
				Next
				suma = suma mod 11
				
				If suma &gt;= 10 Then
					Form.SetError klaida, Array(kodas)
					rt=false
				else
					If CInt(Right(kodas.Value,1)) &lt;&gt; suma Then
						Form.SetError klaida, Array(kodas)
						rt=false
					End If
				End If
			case 10
				suma = 0
				
				For i = 1 to 9
					suma = suma + CInt(Mid(Left(kodas.Value,9), i, 1)) * (10-i)
				Next
				suma = suma mod CInt(Left(kodas.Value,2))
				
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If suma &gt;= 10 Then
					suma1 = 0
					
					For i = 1 to Len(suma)
						suma1 = suma1 + CInt(Mid(Cstr(suma), i, 1))
					Next
					suma = suma1
				End If
				
				If CInt(Right(kodas.Value,1)) &lt;&gt; suma Then
				'	Form.SetError klaida, Array(pagesPLN204_1.Item( 1 ).Fields.ItemByName( "B_MM_ID" ) )
					Form.SetError klaida, Array(kodas)
					rt=false
				End If
			case else
				Form.SetError klaida, Array(kodas)
				rt=false
			End Select
		else
			rt=false
		End If
		JAR_tikrinimas=rt
end function

function ZeroToEstring ( value )
	if value &lt;&gt; 0 then
		ZeroToEstring = Form.FormatDecimal(value)
	else
		ZeroToEstring = ""
	end if
end Function

