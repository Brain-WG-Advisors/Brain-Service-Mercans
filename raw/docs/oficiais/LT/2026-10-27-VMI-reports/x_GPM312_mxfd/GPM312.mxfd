			if b5_7=true then form.seterror "U5 laukelyje pasirinkus 07 pajamų rūšies kodą, U8 laukelyje įrašyta išmokos suma neturi viršyti 200 Eur. Viršijanti 200 Eur prizų ir dovanų suma iš darbdavio yra apmokestinama ir deklaruojama 01 kodu.", m5_7,el_warning
			If b6 = True Then Form.SetError "PASITIKRINKITE IŠMOKAS NATŪRA. Jei išmokėjote pinigais, U6 laukelis turi būti neužpildytas.", m6, El_Warning
		'ork--------- 78 Excel eilutė
			'if b7 then form.seterror "Jei U8 laukelyje nurodyta išmoka išmokėta darbdavio, U7 laukelyje turi būti pasirenkama ""D-individualios veiklos išmoka, išmokėta įdarbintam asmeniui""", m7,el_warning
			if b7 then form.seterror "Jei U8 laukelyje nurodyta individualios veiklos išmoka išmokėta darbdavio, U7 laukelyje turi būti pasirenkama ""D"".", m7,el_warning
			if b8=true then form.seterror"U8 laukelyje deklaruojama išmokų suma lygi arba mažesnė už U10 ir U11 laukeliuose įrašytą mokesčio sumą", m8, el_warning
			if b8_1=true then form.seterror"U8 laukelyje deklaruotos neapmokestinamos pajamos. Pasitikrinkite ar teisingai nurodyta GPM suma U10 ir/ar U11 laukeliuose.", m8_1,el_warning
			if b9_0=true then form.seterror"U9 laukelyje turi būti įrašomas 0, jei U8 laukelyje įrašytos pajamų mokesčiu neapmokestinamos  sumos. Pasitikrinkite deklaruotas sumas.", m9_0, el_warning
			if b9_1=true then form.seterror"Nurodyta GPM suma (U10+U11) nelygi GPM sumai, apskaičiuotai pagal išmokos sumą (U8) ir pasirinktą GPM tarifą (U9). Skirtingais GPM tarifais apmokestinamos tos pačios klasės ir rūšies išmokos deklaruojamos atskirose eilutėse. Pasitikrinkite sumas.", m9_1, el_warning
