			end if
			'if b9_12=true then form.seterror "U9 laukelyje nurodytas neteisingas GPM tarifas", m9_12,el_warning
			'if b9_10=true then form.seterror "U9 laukelyje nurodytas neteisingas GPM tarifas", m9_10,el_error
			'if b9_5=true then form.seterror "U9 laukelyje nurodytas neteisingas GPM tarifas", m9_5,el_warning
			if b11=true then form.seterror "Pasitikrinkite, ar U11 laukelyje nurodoma išmokas išmokėjusio asmens iš savo lėšų sumokėta GPM suma. Išskaičiuota ir į biudžetą sumokėta GPM suma nurodoma tik U10 laukelyje.", m11,el_warning
			if b10_11=true then form.seterror "U10 ir U11 laukeliuose nurodyta sudvigubinta GPM suma. Išskaičiuota ir į biudžetą sumokėta GPM suma nurodoma tik U10 laukelyje, U11 laukelyje nurodoma išmokas išmokėjusio asmens iš savo lėšų sumokėta GPM suma.", m10_11,el_error
		next
	end if
	' kratom U1_U8
	If U1_U8.Count &gt; 0 Then
		tmp = U1_U8.Keys
		For Each k in tmp
			If CCur(U1_U8.Item(k)) &gt; 100000 Then
				
				ReDim tmp_2(0)
				For i = 1 To pagesGPM312U.Count
					Set fieldsGPM312U = pagesGPM312U.Item(i).Fields
					
					for j = 1 to 5
						If fieldsGPM312U.ItemByName("U1-"&amp;j).Value = k Then
							If metai &gt;= 2020 and fieldsGPM312U.ItemByName("U1-"&amp;j).Value &lt;&gt; "" and _
							   fieldsGPM312U.ItemByName("U5-"&amp;j).Value &lt;&gt; "" and fieldsGPM312U.ItemByName("U7-"&amp;j).Value = "M" Then
								If U5_Ne_Is_U7_M_Saraso(fieldsGPM312U.ItemByName("U5-"&amp;j)) = False Then
									'reikia masyvo, kur 0 stulpelis = U1, o 1 stulpelis = U7 ir 2 stulpelis = U8
									
									If Ubound(tmp_2) &lt; 2 Then
										ReDim Preserve tmp_2(2)
									else
										ReDim Preserve tmp_2(Ubound(tmp_2) + 3)
									End If
									
									Set tmp_2(Ubound(tmp_2) - 2) = fieldsGPM312U.ItemByName("U1-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 1) = fieldsGPM312U.ItemByName("U7-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 0) = fieldsGPM312U.ItemByName("U8-"&amp;j)
								End If
							End If
						End If
					Next
				Next
				
				Form.SetError "Bendra pagal mažosios bendrijos nario su mažąja bendrija sudarytas civilines sutartis suteiktų paslaugų ir darbų suma, išmokėta po 2020-11-19, negali viršyti 100 000 eurų per kalendorinius metus. Viršyta suma deklaruojama 02 ar 26 pajamų rūšies kodais.", tmp_2
			End If
		Next
	End If
	' kratom U13_U8
	If U13_U8.Count &gt; 0 Then
		tmp = U13_U8.Keys
		For Each k in tmp
			If CCur(U13_U8.Item(k)) &gt; 100000 Then
				
				ReDim tmp_2(0)
				For i = 1 To pagesGPM312U.Count
					Set fieldsGPM312U = pagesGPM312U.Item(i).Fields
					
					for j = 1 to 5
						If fieldsGPM312U.ItemByName("U13-"&amp;j).Value = Mid(k, 3) Then
							If metai &gt;= 2020 and fieldsGPM312U.ItemByName("U1-"&amp;j).Value = "" and _
							   (fieldsGPM312U.ItemByName("U13-"&amp;j).Value &lt;&gt; "" and fieldsGPM312U.ItemByName("U14-"&amp;j).Value &lt;&gt; "") _
							   and fieldsGPM312U.ItemByName("U5-"&amp;j).Value &lt;&gt; "" and fieldsGPM312U.ItemByName("U7-"&amp;j).Value = "M" Then
								If U5_Ne_Is_U7_M_Saraso(fieldsGPM312U.ItemByName("U5-"&amp;j)) = False Then
									'reikia masyvo, kur 0 stulpelis = U14&amp;U13, o 1 stulpelis = U7 ir 2 stulpelis = U8
									
									If Ubound(tmp_2) &lt; 2 Then
										ReDim Preserve tmp_2(2)
									else
										ReDim Preserve tmp_2(Ubound(tmp_2) + 3)
									End If
									
									Set tmp_2(Ubound(tmp_2) - 2) = fieldsGPM312U.ItemByName("U13-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 1) = fieldsGPM312U.ItemByName("U7-"&amp;j)
									Set tmp_2(Ubound(tmp_2) - 0) = fieldsGPM312U.ItemByName("U8-"&amp;j)
								End If
							End If
						End If
					Next
				Next
				
				Form.SetError "Bendra pagal mažosios bendrijos nario su mažąja bendrija sudarytas civilines sutartis suteiktų paslaugų ir darbų suma, išmokėta po 2020-11-19, negali viršyti 100 000 eurų per kalendorinius metus. Viršyta suma deklaruojama 02 ar 26 pajamų rūšies kodais.", tmp_2
			End If
		Next
	End If
	
'Laikinai atsisakyta dublių gaudymo
