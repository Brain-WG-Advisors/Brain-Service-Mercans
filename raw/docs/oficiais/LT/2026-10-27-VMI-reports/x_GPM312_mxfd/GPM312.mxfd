isplayName="individualios veiklos pažymos, išduotos LR VMI, numeris">4</ListItem><ListItem DisplayName="Lietuvos Respublikoje išduoto paso serija ir numeris arba asmens tapatybės kortelės ar leidimo nuolat arba laikinai gyventi Lietuvos Respublikoje numeris">5</ListItem></ListItems><UseListPropperties>UseListOnly</UseListPropperties></FieldDataDef><FieldDataDef FieldName="L3-1" Comment="" SettingName="" DataType="Text" ReferedXFDItem="0x3C2C7006"><IsRequired>false</IsRequired><IsReadOnly>false</IsReadOnly><Rect l="1329" t="458" r="2927" b="517" /><FieldMarking HasCellsMarking="true" CellsInRowCount="34" RowsCount="1" /><TextFormat><FontName>Arial</FontName><FontSize>10</FontSize><IsFontBold>false</IsFontBold><IsFontUnderline>false</IsFontUnderline><IsFontItalic>false</IsFontItalic><IsFontStrikeout>false</IsFontStrikeout><AutoSizeFont>false</AutoSizeFont></TextFormat><HorizontalAlignment>LeftJustified</HorizontalAlignment><VerticalAlignment>BaseLine</VerticalAlignment><UseUppercase>true</UseUppercase><ListItems></ListItems><UseListPropperties>DontUseList</UseListPropperties></FieldDataDef><FieldDataDef FieldName="L4-1" Comment="" SettingName="" DataType="Text" ReferedXFDItem="0x115A9011"><IsRequired>false</IsRequired><IsReadOnly>false</IsReadOnly><Rect l="3030" t="464" r="3065" b="511" /><FieldMarking HasCellsMarking="true" CellsInRowCount="1" RowsCount="1" /><TextFormat><FontName>Arial</FontName><FontSize>10</FontSize><IsFontBold>false</IsFontBold><IsFontUnderline>false</IsFontUnderline><IsFontItalic>false</IsFontItalic><IsFontStrikeout>false</IsFontStrikeout><AutoSizeFont>false</AutoSizeFont></TextFormat><HorizontalAlignment>LeftJustified</HorizontalAlignment><VerticalAlignment>BaseLine</VerticalAlignment><UseUppercase>true</UseUppercase><ListItems><ListItem DisplayName=""></ListItem><ListItem DisplayName="A klasės išmokos">A</ListItem><ListItem DisplayName="B klasės išmokos">B</ListItem></ListItems><UseListPropperties>UseListOnly</UseListPropperties></FieldDataDef><FieldDataDef FieldName="L5-1" Comment="" SettingName="" DataType="Text" ReferedXFDItem="0x7927C001"><IsRequired>false</IsRequired><IsReadOnly>false</IsReadOnly><Rect l="3154" t="458" r="3248" b="517" /><FieldMarking HasCellsMarking="true" CellsInRowCount="2" RowsCount="1" /><TextFormat><FontName>Arial</FontName><FontSize>10</FontSize><IsFontBold>false</IsFontBold><IsFontUnderline>false</IsFontUnderline><IsFontItalic>false</IsFontItalic><IsFontStrikeout>false</IsFontStrikeout><AutoSizeFont>false</AutoSizeFont></TextFormat><HorizontalAlignment>LeftJustified</HorizontalAlignment><VerticalAlignment>BaseLine</VerticalAlignment><UseUppercase>true</UseUppercase><ListItems><ListItem DisplayName="Su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos (įskaitant atleidžiamas nuo pajamų mokesčio pagal GPMĮ 37 straipsnį), išskyrus žymimas 04 ir 08 kodais">01</ListItem><ListItem DisplayName="Neribotos civilinės atsakomybės vieneto savo dalyviui ar MB savo nariui išmokėtos išmokos, pagal GPMĮ 2 str. 34 dalį priskiriamos su darbo santykiais ar jų esmę atitinkančiais santykiais susijusioms pajamoms">02</ListItem><ListItem DisplayName="Ligos, motinystės, tėvystės, vaiko priežiūros ir ilgalaikio darbo išmokos">03</ListItem><ListItem DisplayName="Iki 2018 m. gruodžio 31 d. apskaičiuotos su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos, išmokėtos 2019 metais ir vėlesniais mokestiniais laikotarpiais (nuo 2019-01-01)">04</ListItem><ListItem DisplayName="Dienpinigiai, išmokėti į komandiruotę išsiųstiems darbuotojams Komandiruočių sąnaudų atskaitymo iš pajamų taisyklių, patvirtintų LR Vyriausybės 2003 m. sausio 28 d. nutarimo Nr. 99 „Dėl komandiruočių sąnaudų atskaitymo iš pajamų taisyklių patvirtinimo“ nustatyta tvarka">05</ListItem><ListItem DisplayName="LR darbo kodekso nustatyta tvarka išmokėtos padidėjusių išlaidų kompensacijos darbuotojams, kurių darbas yra kilnojamojo pobūdžio arba susijęs su kelionėmis ar važiavimu">06</ListItem><ListItem DisplayName="Asmens, susijusio su gyventoju darbo santykiais ar jų esmę atitinkančiais santykiais, išmokėtų prizų ir dovanų vertė, per mokestinį laikotarpį neviršijanti 200 eurų">07</ListItem><ListItem DisplayName="Su darbo santykiais arba jų esmę atitinkančiais santykiais susijusios išmokos, kurios neapmokestinamos pagal GPMĮ 17 straipsnį, išskyrus žymimas 05, 06 ir 07 kodais">08</ListItem><ListItem DisplayName="Ligos išmokos jūrininkams, kurios neapmokestinamos pagal GPMĮ 17 straipsnio 1 dalies 45 punktą">09</ListItem><ListItem DisplayName="Finansinių priemonių pardavimo ar kitokio perleidimo nuosavybėn išmokos ir išvestinių finansinių priemonių realizavimo išmokos">12</ListItem><ListItem DisplayName="Kito turto pardavimo ar kitokio perleidimo nuosavybėn išmokos, išskyrus žymimas 12, 14, 15, 16, 17, 18 ir 34 kodais">13</ListItem><ListItem DisplayName="Nenukirsto miško ir apvaliosios medienos pardavimo ar kitokio perleidimo nuosavybėn išmokos">14</ListItem><ListItem DisplayName="Ne individualios veiklos atliekų pardavimo ar kitokio perleidimo nuosavybėn išmokos">15</ListItem><ListItem DisplayName="Privalomai registruotino kilnojamojo daikto arba daikto, kuris nekilnojamuoju pripažįstamas pagal įstatymus, pardavimo ar kitokio perleidimo nuosavybėn išmokos">16</ListItem><ListItem DisplayName="Nekilnojamojo pagal prigimtį daikto pardavimo ar kitokio perleidimo nuosavybėn išmokos (išskyrus žymimas 18 kodu)">17</ListItem><ListItem DisplayName="Būsto (įskaitant priskirtą žemę) pardavimo ar kitokio perleidimo nuosavybėn išmokos">18</ListItem><ListItem DisplayName="Už parduotas paties gyventojo surinktas miško gėrybes (grybus, uogas, riešutus, vaistažoles) išmokėtos išmokos">34</ListItem><ListItem DisplayName="Nekilnojamojo pagal prigimtį daikto nuomos išmokos">23</ListItem><ListItem DisplayName="Kito turto nuomos išmokos, išskyrus žymimas 23 kodu">24</ListItem><ListItem DisplayName="Išmokos iš paskirstytojo pelno (dividendai) (įskaitant tarpininkų išmokėtus dividendus, gautus iš užsienio vienetų)">26</ListItem><ListItem DisplayName="Neribotos civilinės atsakomybės vieneto savo dalyviui išmokėtos išmokos iš pelno (nuo 2019-01-01)">27</ListItem><ListItem DisplayName="Kooperatinės bendrovės (kooperatyvo) dalyviui (nariui) išmokėtos išmokos, skirstant šios kooperatinės bendrovės (kooperatyvo) pelną">29</ListItem><ListItem DisplayName="Sporto varžybų prizas (išskyrus žymimus 31 kodu), jeigu šį prizą įsteigia ir skiria olimpiniam, parolimpiniam, regos, klausos ar judėjimo negalią turinčių asmenų sporto judėjimams Lietuvoje vadovaujančios nevyriausybinės organizacijos, tarptautinės sporto šakų federacijos ar šių federacijų nariai, Lietuvos sporto šakų federacijos">30</ListItem><ListItem DisplayName="Prizai ir laimėjimai, gauti ne iš darbdavio, išskyrus žymimus 07, 30, 42 ir 43 kodais">31</ListItem><ListItem DisplayName="Azartinių lošimų laimėjimai">42</ListItem><ListItem DisplayName="Loterijų laimėjimai, išmokėti Lietuvos vienetų, kurie LR teisės aktų nustatyta tvarka moka mokestį nuo loterijų apyvartos">43</ListItem><ListItem DisplayName="Juridinių asmenų (nesusijusių su darbo ar jų esmę atitinkančiais santykiais) padovanotos dovanos">46</ListItem><ListItem DisplayName="Pensijos, pensijų anuitetai, rentos">48</ListItem><ListItem DisplayName="Pensijų kaupimo išmokos, ne didesnės už sumokėtas įmokas">71</ListItem><ListItem DisplayName="Pensijų kaupimo išmokos, viršijančios sumokėtas įmokas">76</ListItem><ListItem DisplayName="Palūkanos už vartojimo kreditą, suteiktą per tarpusavio skolinimo platformą, ir / arba palūkanos už lėšas, suteiktas per sutelktinio finansavimo platformą">55</ListItem><ListItem DisplayName="Indėlių palūkanos už EEE valstybių kredito įstaigose laikomus indėlius pagal sutartis, sudarytas iki 2013 m. gruodžio 31 d.">56</ListItem><ListItem DisplayName="Palūkanos už paskolas">58</ListItem><ListItem DisplayName="Kitos palūkanos, išskyrus žymimas 55, 56, 58, 64, 65, 66, 67 ir 69 kodais">59</ListItem><ListItem Dis