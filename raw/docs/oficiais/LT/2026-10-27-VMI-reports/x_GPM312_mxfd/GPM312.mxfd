Function CheckVersion()
	If IsUptodateVersion() = False Then
		Form.SetError "Norint apdoroti šią formą, reikia atnaujinti eFormFiller programą.", , EL_CriticalError
		CheckVersion = False
		Exit Function
	End If
	CheckVersion = True
End Function

Function IsUptodateVersion()
	On Error Resume Next
	Dim temp
	
	temp = ExportInstructions.Count
	If Err.Number &lt;&gt; 0 Then
		IsUptodateVersion = False
		Exit Function
	End If
	Err.Clear
	
	temp = Form.FormatNumeric("1", ".")
	If Err.Number &lt;&gt; 0 Then
		IsUptodateVersion = False
		Exit Function
	End If
	Err.Clear
	
	temp = Form.FormatCurrency("1", ".")
	If Err.Number &lt;&gt; 0 Then
		IsUptodateVersion = False
		Exit Function
	End If
	Err.Clear
	
	IsUptodateVersion = True
End Function</ScriptModule><EmbeddedFonts Count="Fonts Count"><EmbeddedFont FontName="Font Name" FontFamily="Font Family" IsEncrypted="Encryption"></EmbeddedFont></EmbeddedFonts></FormDef></MXFD>