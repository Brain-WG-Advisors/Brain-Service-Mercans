		ReDim tarifai_L9(6)
		
		tarifai_L9(0)   = "5,00;5 proc."
		tarifai_L9(1)   = "15,00;15 proc."
		tarifai_L9(2)   = "20,00;20 proc."
		tarifai_L9(3)   = "0,00;Neapmokestinamos pajamos"
		tarifai_L9(4)   = "25,00;25 proc."
		tarifai_L9(5)   = "27,00;27 proc."
		tarifai_L9(6)   = "32,00;32 proc."
		
		ReDim tarifai_U9(8)
		
		tarifai_U9(0)   = "5,00;5 proc."
		tarifai_U9(1)   = "7,50;7,5 proc."
		tarifai_U9(2)   = "10,00;10 proc."
		tarifai_U9(3)   = "15,00;15 proc."
		tarifai_U9(4)   = "20,00;20 proc."
		tarifai_U9(5)   = "0,00;Neapmokestinamos pajamos"
		tarifai_U9(6)   = "25,00;25 proc."
		tarifai_U9(7)   = "27,00;27 proc."
		tarifai_U9(8)   = "32,00;32 proc."
		
	end if
	
	Set pagesGPM312L = Form.GetPagesForTemplate( "GPM312L" )
	if  pagesGPM312L.Count&gt;0 then
		
		for i = 1 to pagesGPM312L.count
			set fields = pagesGPM312L.item(i).fields
			
			for j = 1 to 10
				l_kodas = fields.ItemByName("L5-"&amp;j).value
				fields.ItemByName("L5-"&amp;j).AttachList pajamos
				
				For Each ii in pajamos
					If l_kodas = Left(Trim(ii),2) Then
						fields.ItemByName("L5-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("L5-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'L6
				l_kodas = fields.ItemByName("L6-"&amp;j).value
				fields.ItemByName("L6-"&amp;j).AttachList ismokos_6
				
				For Each ii in ismokos_6
					If l_kodas = Left(Trim(ii),1) Then
						fields.ItemByName("L6-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("L6-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'L7
				l_kodas = fields.ItemByName("L7-"&amp;j).value
				fields.ItemByName("L7-"&amp;j).AttachList ismokos_7
				
				For Each ii in ismokos_7
					If l_kodas = Left(Trim(ii),1) Then
						fields.ItemByName("L7-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("L7-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'L9
				l_kodas = fields.ItemByName("L9-"&amp;j).value
				fields.ItemByName("L9-"&amp;j).AttachList tarifai_L9
				
				For Each ii in tarifai_L9
					If l_kodas = Left(Trim(ii), Len(Trim(l_kodas)) ) Then
						fields.ItemByName("L9-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("L9-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
			next
		next
	end if
	
	Set pagesGPM312U = Form.GetPagesForTemplate( "GPM312U" )
	if  pagesGPM312U.Count&gt;0 then
		
		for i = 1 to pagesGPM312U.count
			set fields = pagesGPM312U.item(i).fields
			
			for j = 1 to 5
				l_kodas = fields.ItemByName("U5-"&amp;j).value
				fields.ItemByName("U5-"&amp;j).AttachList pajamos
				
				For Each ii in pajamos
					If l_kodas = Left(Trim(ii),2) Then
						fields.ItemByName("U5-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("U5-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'U6
				l_kodas = fields.ItemByName("U6-"&amp;j).value
				fields.ItemByName("U6-"&amp;j).AttachList ismokos_6
				
				For Each ii in ismokos_6
					If l_kodas = Left(Trim(ii),1) Then
						fields.ItemByName("U6-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("U6-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'U7
				l_kodas = fields.ItemByName("U7-"&amp;j).value
				fields.ItemByName("U7-"&amp;j).AttachList ismokos_7_U
				
				For Each ii in ismokos_7_U
					If l_kodas = Left(Trim(ii),1) Then
						fields.ItemByName("U7-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						fields.ItemByName("U7-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
				
				'U9
				l_kodas = fields.ItemByName("U9-"&amp;j).value
				fields.ItemByName("U9-"&amp;j).AttachList tarifai_U9
				
				For Each ii in tarifai_U9
					If l_kodas = Left(Trim(ii), Len(Trim(l_kodas)) ) Then
						'Form.Seterror "U9 - Taip, Lapo Nr. ="&amp; cStr(i) &amp; "- eilutės Nr = "&amp; cStr(j) &amp;" .", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						'Form.Seterror "U9 - Taip, l_kodas ="&amp; l_kodas &amp; ".", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						'Form.Seterror "U9 - Taip, Left(Trim(ii), Len(Trim(l_kodas)) ) ="&amp; Left(Trim(ii), Len(Trim(l_kodas)) ) &amp; ".", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						
						fields.ItemByName("U9-"&amp;j).SetCheckValue cStr(l_kodas)
						Exit For
					else
						'kodas.SetCheckValue cStr(l_kodas)
						
						'Form.Seterror "U9 - Ne, Lapo Nr. ="&amp; cStr(i) &amp; "- eilutės Nr = "&amp; cStr(j) &amp;" .", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						'Form.Seterror "U9 - Ne, l_kodas ="&amp; l_kodas &amp; ".", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						'Form.Seterror "U9 - Ne, Left(Trim(ii), Len(Trim(l_kodas)) ) ="&amp; Left(Trim(ii), Len(Trim(l_kodas)) ) &amp; ".", Array(fields.ItemByName("U9-"&amp;j), laikotarpis)
						
						fields.ItemByName("U9-"&amp;j).SetCheckValue cStr(l_kodas)
					End If
				Next
			next
		next
	end if
End sub

Sub onExportToExcel()
	'Add your code here
	If CheckVersion = False Then
        	Exit Sub
        End If
	
	'GPM312 eksportas
	
	dim pages, fields
	dim i, j, k, count, eil_pradine, eil_galutine
	dim field_name(), field_value(), index()
	
	Set pages = Form.GetPagesForTemplate("GPM312")
	Set fields = Pages.Item(1).fields
	
	ExportInstructions.Add "GPM312", 1,1, "METINĖ GYVENTOJAMS IŠMOKĖTŲ IŠMOKŲ, PRISKIRIAMŲ A IR B KLASĖS PAJAMOMS, DEKLARACIJA"
	
	ExportInstructions.Add "GPM312", 1,3, "Nr."
	ExportInstructions.Add "GPM312", 2,3, "Lauko pavadinimas"
	ExportInstructions.Add "GPM312", 3,3, "Lauko reikšmė"
	
	ExportInstructions.Add "GPM312", 1, 4, "1"
	ExportInstructions.Add "GPM312", 2, 4, "Išmokas išmokėjusio asmens identifikacinis numeris (kodas)"
	ExportInstructions.Add "GPM312", 3, 4, fields.ItemByName("B_MM_ID").Value
	ExportInstructions.Add "GPM312", 1, 5, "2"
	ExportInstructions.Add "GPM312", 2, 5, "Išmokas išmokėjusio asmens pavadinimas / vardas, pavardė"
	ExportInstructions.Add "GPM312", 3, 5, fields.ItemByName("B_MM_Pavad").Value
	ExportInstructions.Add "GPM312", 1, 6, "3"
	ExportInstructions.Add "GPM312", 2, 6, "Mokestinis laikotarpis"
	ExportInstructions.Add "GPM312", 3, 6, fields.ItemByName("B_ML_Metai").Value
	ExportInstructions.Add "GPM312", 1, 7, "4"
	ExportInstructions.Add "GPM312", 2, 7, "Bendra išmokų, neatėmus NPD, GPM, VSDĮ ir PSDĮ, suma"
	ExportInstructions.Add "GPM312", 3, 7, fields.ItemByName("G4").Value
	ExportInstructions.Add "GPM312", 1, 8, "5"
	ExportInstructions.Add "GPM312", 2, 8, "Bendra išskaičiuota GPM suma"
	ExportInstructions.Add "GPM312", 3, 8, fields.ItemByName("G5").Value
	ExportInstructions.Add "GPM312", 1, 9, "6"
	ExportInstructions.Add "GPM312", 2, 9, "Bendra išmokas išmokėjusio asmens lėšomis sumokėta GPM suma"
	ExportInstructions.Add "GPM312", 3, 9, fields.ItemByName("G6").Value
	ExportInstructions.Add "GPM312", 1,10, "7"
	ExportInstructions.Add "GPM312", 2,10, "Bendra užsienio valstybėse sumokėta GPM suma"
	ExportInstructions.Add "GPM312", 3,10, fields.ItemByName("G7").Value
	
	'GPM312L priedu eksportas
	
	ReDim field_name(13), field_value(13), index(13+1)
	
	field_name(1 ) = "Identifikacinis numeris (kodas)"
	field_name(2 ) = "Identifikacinio numerio (kodo) rūšis"
	field_name(3 ) = "Vardas, pavardė"
	field_name(4 ) = "Išmokos klasė"
	field_name(5 ) = "Išmokos rūšis"
	field_name(6 ) = "Išmoka natūra"
	field_name(7 ) = "Darbdavio išmoka"
	field_name(8 ) = "Išmokos, neatėmus NPD, GPM, VSDĮ ir PSDĮ, suma"
	field_name(9 ) = "GPM tarifas"
	field_name(10) = "Išskaičiuota GPM suma"
	field_name(11) = "Išmokas išmokėjusio asmens lėšomis sumokėta GPM suma"
	field_name(12) = "Užsienio valstybės kodas"
	field_name(13) = "Užsienio valstybėje sumokėta GPM suma"
	
	Set pages = Form.GetPagesForTemplate("GPM312L")
	
	if pages.Count &lt;&gt; 0 then
		ExportInstructions.Add "GPM312L", 1,1, "NUOLATINIAMS LIETUVOS GYVENTOJAMS IŠMOKĖTOS IŠMOKOS"
		
		for i = 1 to UBound(field_name)
			ExportInstructions.Add "GPM312L", i, 3,field_name(i)
		next
		
		eil_pradine = 5	'Excel lentelės eilutės numeris nuo kurios prasidės duomenų lenta
		eil_galutine = 0
		
		for i = 1 to pages.count
			set fields = pages.item(i).fields
			
			count = 0
			for j = 1 to 10
				if fields.ItemByName("L1-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("L2-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("L3-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("L4-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("L5-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("L8-"&amp;j).Value &lt;&gt; "" then
					count = count +1
					index(count) = j
				end if
			next
			
			if count &lt;&gt; 0 then
				eil_galutine = eil_pradine + count - 1
				
				for j = eil_pradine to eil_galutine
					field_value(1)  = fields.ItemByName("L1-" &amp;index(j-eil_pradine+1)).Value
					field_value(2)  = fields.ItemByName("L2-" &amp;index(j-eil_pradine+1)).Value
					field_value(3)  = fields.ItemByName("L3-" &amp;index(j-eil_pradine+1)).Value
					field_value(4)  = fields.ItemByName("L4-" &amp;index(j-eil_pradine+1)).Value
					field_value(5)  = fields.ItemByName("L5-" &amp;index(j-eil_pradine+1)).Value
					field_value(6)  = fields.ItemByName("L6-" &amp;index(j-eil_pradine+1)).Value
					field_value(7)  = fields.ItemByName("L7-" &amp;index(j-eil_pradine+1)).Value
					field_value(8)  = fields.ItemByName("L8-" &amp;index(j-eil_pradine+1)).Value
					field_value(9)  = fields.ItemByName("L9-" &amp;index(j-eil_pradine+1)).Value
					field_value(10) = fields.ItemByName("L10-"&amp;index(j-eil_pradine+1)).Value
					field_value(11) = fields.ItemByName("L11-"&amp;index(j-eil_pradine+1)).Value
					field_value(12) = fields.ItemByName("L12-"&amp;index(j-eil_pradine+1)).Value
					field_value(13) = fields.ItemByName("L13-"&amp;index(j-eil_pradine+1)).Value
					
					for k = 1 to UBound(field_name)
						ExportInstructions.Add "GPM312L", k, j, field_value(k)
					next
				next
			else
				eil_galutine = eil_pradine -1	'kai nebuvo eilučių su užpildytu bent vienu iš eilutėje privalomų L1, L2, L3, L4, L5 ir L8 laukelių.
			end if
			eil_pradine = eil_galutine+1
		next
		
		if eil_pradine &gt; 65000 or eil_galutine &gt; 65000 then
			Form.SetError "GPM312L priedų eksportuojamų eilučių kiekis peržengta 2003 Excel eilučių riba 65 000." , , EL_Error
		end if
	end if
	
	'GPM312U priedu eksportas
	
	ReDim field_name(15), field_value(15), index(14+1)
	
	field_name(1 ) = "Identifikacinis numeris (kodas)"
	field_name(2 ) = "Identifikacinio numerio (kodo) rūšis"
	field_name(3 ) = "Vardas, pavardė"
	field_name(4 ) = "Išmokos klasė"
	field_name(5 ) = "Išmokos rūšis"
	field_name(6 ) = "Išmoka natūra"
	field_name(7 ) = "Darbdavio išmoka"
	field_name(8 ) = "Išmokos, neatėmus NPD, GPM, VSDĮ ir PSDĮ, suma"
	field_name(9 ) = "GPM tarifas"
	field_name(10) = "Išskaičiuota GPM suma"
	field_name(11) = "Išmokas išmokėjusio asmens lėšomis sumokėta GPM suma"
	field_name(12) = "Gimimo data"
	field_name(13) = "Mokesčių mokėtojo kodas užsienio valstybėje"
	field_name(14) = "Valstybės kodas"
	field_name(15) = "Adresas užsienio valstybėje"
	
	Set pages = Form.GetPagesForTemplate("GPM312U")
	
	if pages.Count &lt;&gt; 0 then
		ExportInstructions.Add "GPM312U", 1,1, "NENUOLATINIAMS LIETUVOS GYVENTOJAMS IŠMOKĖTOS IŠMOKOS"
		
		for i = 1 to UBound(field_name)
			ExportInstructions.Add "GPM312U", i, 3,field_name(i)
		next
		
		eil_pradine = 5	'Excel lentelės eilutės numeris nuo kurios prasidės duomenų lenta
		eil_galutine = 0
		
		for i = 1 to pages.count
			set fields = pages.item(i).fields
			
			count = 0
			for j = 1 to 5
				if fields.ItemByName("U3-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("U4-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("U5-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("U8-"&amp;j).Value &lt;&gt; "" or fields.ItemByName("U14-"&amp;j).Value &lt;&gt; "" then
					count = count +1
					index(count) = j
				end if
			next
			
			if count &lt;&gt; 0 then
				eil_galutine = eil_pradine + count - 1
				
				for j = eil_pradine to eil_galutine
					field_value(1)  = fields.ItemByName("U1-" &amp;index(j-eil_pradine+1)).Value
					field_value(2)  = fields.ItemByName("U2-" &amp;index(j-eil_pradine+1)).Value
					field_value(3)  = fields.ItemByName("U3-" &amp;index(j-eil_pradine+1)).Value
					field_value(4)  = fields.ItemByName("U4-" &amp;index(j-eil_pradine+1)).Value
					field_value(5)  = fields.ItemByName("U5-" &amp;index(j-eil_pradine+1)).Value
					field_value(6)  = fields.ItemByName("U6-" &amp;index(j-eil_pradine+1)).Value
					field_value(7)  = fields.ItemByName("U7-" &amp;index(j-eil_pradine+1)).Value
					field_value(8)  = fields.ItemByName("U8-" &amp;index(j-eil_pradine+1)).Value
					field_value(9)  = fields.ItemByName("U9-" &amp;index(j-eil_pradine+1)).Value
					field_value(10) = fields.ItemByName("U10-"&amp;index(j-eil_pradine+1)).Value
					field_value(11) = fields.ItemByName("U11-"&amp;index(j-eil_pradine+1)).Value
					field_value(12) = fields.ItemByName("U12-"&amp;index(j-eil_pradine+1)).Value
					field_value(13) = fields.ItemByName("U13-"&amp;index(j-eil_pradine+1)).Value
					field_value(14) = fields.ItemByName("U14-"&amp;index(j-eil_pradine+1)).Value
					field_value(15) = fields.ItemByName("U15-"&amp;index(j-eil_pradine+1)).Value
					
					for k = 1 to UBound(field_name)
						ExportInstructions.Add "GPM312U", k, j, field_value(k)
					next
				next
			else
				eil_galutine = eil_pradine -1	'kai nebuvo eilučių su užpildytu bent vienu iš eilutėje privalomų U3, U4, U5, U8 ir U14 laukelių.
			end if
			eil_pradine = eil_galutine+1
		next
		
		if eil_pradine &gt; 65000 or eil_galutine &gt; 65000 then
			Form.SetError "GPM312U priedų eksportuojamų eilučių kiekis peržengta 2003 Excel eilučių riba 65 000." , , EL_Error
		end if
	end if
	
	If ExportInstructions.RunExport = FALSE then
		Form.SetError "Eksporto klaida" , , EL_Error
	End If
End Sub

Sub GPM312
	dim pagesGPM312,fieldsGPM312
	dim pagesGPM312L,fieldsGPM312L
	dim pagesGPM312U,fieldsGPM312U
	dim i, j, k
	dim tmp, sys_date
	dim sumL8, sumU8, sumL10, sumU10, sumL11, sumU11, sumL13
	dim sumLU8, sumLU10, sumLU11
	
	Set pagesGPM312 = Form.GetPagesForTemplate("GPM312")
	Set fieldsGPM312 = pagesGPM312.Item(1).Fields
	Set pagesGPM312L = Form.GetPagesForTemplate("GPM312L")
	Set pagesGPM312U = Form.GetPagesForTemplate("GPM312U")
	
	if pagesGPM312L.Count = 0 and pagesGPM312U.Count = 0 then form.seterror"Neužpildytas nei vienas iš GPM312L ir\ar GPM312U priedų",,el_error
	if pagesGPM312L.Count &gt; 0 then
		For i = 1 To pagesGPM312L.Count
			tmp = false
			for j = 1 to 10
				for k = 1 to 13
					Set fieldsGPM312L = pagesGPM312L.Item(i).Fields
					if isfilled(fieldsGPM312L.Itembyname("L"&amp;k&amp;"-"&amp;j)) then
						tmp = true
					end if
				next
			next
			if tmp = false then form.seterror"Pašalinkite neužpildytą GPM312L priedo lapą arba jį užpildykite",array(fieldsGPM312L.Itembyname("LapoNr"))
		next
	end if
	
	if pagesGPM312U.Count &gt; 0 then
		For i = 1 To pagesGPM312U.Count
			tmp = false
			for j = 1 to 5
				for k = 1 to 15
					Set fieldsGPM312U = pagesGPM312U.Item(i).Fields
					if isfilled(fieldsGPM312U.Itembyname("U"&amp;k&amp;"-"&amp;j)) then
						tmp = true
					end if
				next
			next
			if tmp = false then form.seterror"Pašalinkite neužpildytą GPM312U priedo lapą arba jį užpildykite",array(fieldsGPM312U.Itembyname("LapoNr"))
		next
	end if
	
	if IsFilled(fieldsGPM312.Itembyname("B_MM_ID")) then
		if len(fieldsGPM312.Itembyname("B_MM_ID").value) &lt; 9 or len(fieldsGPM312.Itembyname("B_MM_ID").value) &gt; 11 then
			form.seterror"1 laukelyje įrašytas neteisingas identifikacinis numeris (turi būti sudarytas iš 9,10 arba 11 skaitmenų)",Array(fieldsGPM312.Itembyname("B_MM_ID"))
		end if
	end if
	
	if len(fieldsGPM312.Itembyname("B_MM_ID").value) = 9 then
		tmp = JAR_tikrinimas(pagesGPM312.Item(1).Fields.ItemByName("B_MM_ID"), "1 laukelyje įrašytas neteisingas mokesčių mokėtojo identifikacinis numeris (Juridinio asmens kodas arba VMI suteiktas mokėtojo kodas)")
	else
		if len(fieldsGPM312.Itembyname("B_MM_ID").value) = 10 then
			tmp =  TIN_tikrinimas (pagesGPM312.Item(1).Fields.ItemByName("B_MM_ID"), "1 laukelyje įrašytas neteisingas mokesčių mokėtojo identifikacinis numeris (Juridinio asmens kodas arba VMI suteiktas mokėtojo kodas)")
		end if
	end if
	
	if len(fieldsGPM312.Itembyname("B_MM_ID").value) = 11 then
		tmp =  AK_tikrinimas (fieldsGPM312.ItemByName("B_MM_ID").value, fieldsGPM312.ItemByName("B_MM_ID"), "Pasitikrinkite 1 laukelyje įrašytą  mokesčių mokėtojo identifikacinį numerį (asmens kodą)")
	end if
	
	if fieldsGPM312.ItemByName("B_MM_Pavad").Value &lt;&gt; "" then
		tmp = Replace(Trim(fieldsGPM312.ItemByName("B_MM_Pavad").Value), "  ", " ")
		While InStr(tmp, "  ") &gt; 0
			tmp = Replace(tmp, "  ", " ")
		WEnd
		fieldsGPM312.ItemByName("B_MM_Pavad").SetCheckValue cStr(tmp)
	end if
	
	'fieldsGPM312.Itembyname("B_ML_Metai").setcheckvalue cstr("2018")
	
'	sys_date = Year(Date)
'	if isfilled(fieldsGPM312.Itembyname("B_ML_Metai")) then
'		if fieldsGPM312.Itembyname("B_ML_Metai").value &lt; 2018 or fieldsGPM312.Itembyname("B_ML_Metai").value &gt; cstr(sys_date) then
'			form.seterror"3 laukelyje nurodytas mokestis laikotarpis negali būti ankstesnis nei 2018 metai arba dar neprasidėję metai",Array(fieldsGPM312.Itembyname("B_ML_Metai"))
'		end if
'	end if
	'CO 465486
	'If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal = 2022 Then
	'If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal = 2023 Then
	'If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal = 2024 Then
	'If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal = 2025 Then
	'If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal &gt;= 2025 Then
	'3013560
	If fieldsGPM312.ItembyName("B_ML_Metai").ToDecimal &gt;= 2026 Then
		'2025 ir 2026 įš sąrašo
		'Form.SetError "Pasitikrinkite ar teisingai nurodėte mokestinį laikotarpį. Už einamuosius metus deklaracijas gali teikti išmokas išmokėję asmenys, kuriems pradėtos bankroto, likvidavimo, restruktūrizavimo ar reorganizavimo procedūros.", Array(fieldsGPM312.Itembyname("B_ML_Metai") ), El_Warning
		Form.SetError "Pasitikrinkite ar teisingai nurodėte mokestinį laikotarpį. Deklaraciją už einamuosius metus gali teikti išmokas išmokėję asmenys, kuriems pradėtos bankroto, likvidavimo, restruktūrizavimo ar reorganizavimo procedūros.", Array(fieldsGPM312.Itembyname("B_ML_Metai") ), El_Warning
	End If
	
	'sumL8 = 0
	'sumL10 = 0
	'sumL11 = 0
	'if pagesGPM312L.Count &gt; 0 then
	'	For i = 1 To pagesGPM312L.Count
	'		Set fieldsGPM312L = pagesGPM312L.Item(i).Fields
	'		
	'		for j = 1 to 10
	'			sumL8 = sumL8 + fieldsGPM312L.Itembyname("L8-"&amp;j).todecimal
	'			sumL10 = sumL10 + fieldsGPM312L.Itembyname("L10-"&amp;j).todecimal
	'			sumL11 = sumL11 + fieldsGPM312L.Itembyname("L11-"&amp;j).todecimal
	'		next
	'	next
	'end if
	
	sumL8 = 0
	sumL10 = 0
	sumL11 = 0
	sumL13 = 0
	if pagesGPM312L.Count &gt; 0 then
		For i = 1 To pagesGPM312L.Count
			Set fieldsGPM312L = pagesGPM312L.Item(i).Fields
			
			for j = 1 to 10
				If fieldsGPM312L.ItemByName("L7-"&amp;j).Value &lt;&gt; "C" Then
					sumL8 = sumL8 + fieldsGPM312L.Itembyname("L8-"&amp;j).todecimal
				End If
				sumL10 = sumL10 + fieldsGPM312L.Itembyname("L10-"&amp;j).todecimal
				sumL11 = sumL11 + fieldsGPM312L.Itembyname("L11-"&amp;j).todecimal
				sumL13 = sumL13 + fieldsGPM312L.Itembyname("L13-"&amp;j).todecimal
			next
		next
	end if
	
	sumU8 = 0
	sumU10 = 0
	sumU11 = 0
	if pagesGPM312U.Count &gt; 0 then
		For i = 1 To pagesGPM312U.Count
			Set fieldsGPM312U = pagesGPM312U.Item(i).Fields
			for j = 1 to 5
				If fieldsGPM312U.ItemByName("U7-"&amp;j).Value &lt;&gt; "C" Then
					sumU8 = sumU8 + fieldsGPM312U.Itembyname("U8-"&amp;j).todecimal
				End If
				sumU10 = sumU10 + fieldsGPM312U.Itembyname("U10-"&amp;j).todecimal
				sumU11 = sumU11 + fieldsGPM312U.Itembyname("U11-"&amp;j).todecimal
			next
		next
	end if
	
	sumLU8 = 0
	sumLU10 = 0
	sumLU11 = 0
	
	sumLU8 = sumL8 + sumU8
	sumLU10 = sumL10 + sumU10
	sumLU11 = sumL11 + sumU11
	
	fieldsGPM312.Itembyname("G4").setcheckvalue cstr(sumLU8)
	fieldsGPM312.Itembyname("G5").setcheckvalue cstr(sumLU10)
	fieldsGPM312.Itembyname("G6").setcheckvalue cstr(sumLU11)
	fieldsGPM312.Itembyname("G7").setcheckvalue cstr(sumL13)
End Sub

sub GPM312L
	dim pagesGPM312,fieldsGPM312
	dim pagesGPM312L,fieldsGPM312L
	dim pagesGPM312U,fieldsGPM312U
	dim i, j, k
	dim tmp, tmp_2, tmp_LT
	Dim b2,m1,b9,m9,b11,m11,b9_10,b9_12,m9_10,m9_12,b9_5,m9_5,b9_10_12,m9_10_12,b9_5_12,m9_5_12,m10_11,b10_11,m10_11_1,b10_11_1,b8,m8,b8_1,m8_1,b9_0,m9_0,b9_1,m9_1
	Dim metai
	dim b5_7, m5_7, b7,m7
	Dim b6, m6
	
	Set pagesGPM312 = Form.GetPagesForTemplate("GPM312")
	Set fieldsGPM312 = pagesGPM312.Item(1).Fields
	Set pagesGPM312L = Form.GetPagesForTemplate("GPM312L")
	Set pagesGPM312U = Form.GetPagesForTemplate("GPM312U")
	
	Dim L1_L8
	Set L1_L8 = CreateObject("Scripting.Dictionary")
	
	Dim L_Dublis
	Set L_Dublis = CreateObject("Scripting.Dictionary")
	
	Dim L_Dublis_1
	Set L_Dublis_1 = CreateObject("Scripting.Dictionary")
	
	if pagesGPM312L.Count &gt; 0 then
		For i = 1 To pagesGPM312L.Count
			b6=false
			m6=array()
			b7=false
			m7=array()
			b5_7=false
			m5_7=array()
			b2=false
			m1=array()
			b10_11_1=false
			m10_11_1=array()
			b8=false
			m8=array()
			b8_1=false
			m8_1=array()
			b9_0=false
			m9_0=array()
			b9_1=false
			m9_1=array()
			b9=false
			m9=array()
			b11=false
			m11=array()
			b9_5=false
			m9_5=array()
			b9_10=false
			m9_10=array()
			b9_12=false
			m9_12=array()
			b9_10_12=false
			m9_10_12=array()
			b9_5_12=false
			m9_5_12=array()
			b10_11=false
			m10_11=array()
			Set fieldsGPM312L = pagesGPM312L.Item(i).Fields
			
			fieldsGPM312L.Itembyname("LapoNr").setcheckvalue Cstr(i)
							
			fieldsGPM312L.Itembyname("B_MM_ID").setcheckvalue cstr(fieldsGPM312.Itembyname("B_MM_ID").value)
			fieldsGPM312L.Itembyname("B_ML_Metai").setcheckvalue cstr(fieldsGPM312.Itembyname("B_ML_Metai").value)
			
			metai = fieldsGPM312.Itembyname("B_ML_Metai").todecimal
			
			for j = 1 to 10	
				
				if fieldsGPM312L.Itembyname("L1-"&amp;j).Value &lt;&gt; "" then
					tmp = Replace(Trim(fieldsGPM312L.Itembyname("L1-"&amp;j).Value), "  ", " ")
					While InStr(tmp, "  ") &gt; 0
						tmp = Replace(tmp, "  ", " ")
					WEnd
					fieldsGPM312L.Itembyname("L1-"&amp;j).SetCheckValue cStr(tmp)
				end if
				if fieldsGPM312L.Itembyname("L3-"&amp;j).Value &lt;&gt; "" then
					tmp = Replace(Trim(fieldsGPM312L.Itembyname("L3-"&amp;j).Value), "  ", " ")
					While InStr(tmp, "  ") &gt; 0
						tmp = Replace(tmp, "  ", " ")
					WEnd
					fieldsGPM312L.Itembyname("L3-"&amp;j).SetCheckValue cStr(tmp)
				end if
				
				tmp = false
				for k = 1 to 13
					if isfilled(fieldsGPM312L.Itembyname("L"&amp;k&amp;"-"&amp;j)) then
						tmp = true
					end if
				next
				if tmp then
					'Bent vienas L1 - L13 laukelis yra užpildytas
					'tmp = false
					if metai = 2018 and _
							(not isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) or _
							not isfilled(fieldsGPM312L.Itembyname("L3-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L4-"&amp;j)) or _
							not isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L8-"&amp;j))) then
						'tmp = true
						form.seterror"Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L4-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j))
					elseif metai &gt;= 2019 and metai &lt;= 2024 and _
							(not isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) or _
							not isfilled(fieldsGPM312L.Itembyname("L3-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L4-"&amp;j)) or _
							not isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L8-"&amp;j)) or _
							not isfilled(fieldsGPM312L.Itembyname("L9-"&amp;j))) then
						'tmp = true
						form.seterror"Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L4-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j), fieldsGPM312L.Itembyname("L9-"&amp;j))
					elseif metai &gt;= 2025 Then
						'tmp = true
						If fieldsGPM312L.ItemByName("L7-"&amp;j).Value &lt;&gt; "C" Then
							If not isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L3-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L4-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L8-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L9-"&amp;j)) Then
								
								form.seterror "Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L4-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j), fieldsGPM312L.Itembyname("L9-"&amp;j))
							End If
						else
							'C
							If not isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L3-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) or not isfilled(fieldsGPM312L.Itembyname("L8-"&amp;j)) or _
								not isfilled(fieldsGPM312L.Itembyname("L9-"&amp;j)) Then
								
								Form.SetError "Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j), fieldsGPM312L.Itembyname("L9-"&amp;j))
							End If
						End If
					end if
				end if
				'if metai = 2018 and tmp then form.seterror"Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L4-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j))
				'if metai &gt;= 2019 and tmp then form.seterror"Visi privalomi eilutės laukeliai turi būti užpildyti", array(fieldsGPM312L.Itembyname("L1-"&amp;j), fieldsGPM312L.Itembyname("L2-"&amp;j), fieldsGPM312L.Itembyname("L3-"&amp;j), fieldsGPM312L.Itembyname("L4-"&amp;j), fieldsGPM312L.Itembyname("L5-"&amp;j), fieldsGPM312L.Itembyname("L8-"&amp;j), fieldsGPM312L.Itembyname("L9-"&amp;j))
				
				if (isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L3-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L4-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L8-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L10-"&amp;j)) or isfilled(fieldsGPM312L.Itembyname("L11-"&amp;j))) and _
				   (fieldsGPM312L.Itembyname("L10-"&amp;j).todecimal&gt;0 and fieldsGPM312L.Itembyname("L11-"&amp;j).todecimal&gt;0) and fieldsGPM312L.Itembyname("L10-"&amp;j).value=fieldsGPM312L.Itembyname("L11-"&amp;j).value then
					Redim Preserve m11(Ubound(m11) + 1)
					set m11(Ubound(m11)) = fieldsGPM312L.Itembyname("L11-"&amp;j)
					b11 = true
				end if
				
				tmp = false
				tmp_2 = false
				if isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
					if len(fieldsGPM312L.Itembyname("L1-"&amp;j).value) = 9 then
						tmp = JAR_tikrinimas (fieldsGPM312L.Itembyname("L1-"&amp;j), "L1 laukelyje nurodytas neteisingas kodas")
					end if
				end if
				if tmp = true then form.seterror "Tais atvejais, kai nežinomas galutinis išmokų gavėjas gyventojas ir išmokos (palūkanos, honorarai ar dividendai) išmokamos tarpininkui juridiniam asmeniui, tokie duomenys deklaruojami GPM312U priede.", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
				
				tmp = false
				if fieldsGPM312L.Itembyname("L2-"&amp;j).todecimal = 1 and isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
					if len(fieldsGPM312L.Itembyname("L1-"&amp;j).value) &lt;&gt; 10 and len(fieldsGPM312L.Itembyname("L1-"&amp;j).value) &lt;&gt; 11 then tmp_2 = true
					if len(fieldsGPM312L.Itembyname("L1-"&amp;j).value) = 10 then
						tmp = TIN_tikrinimas (fieldsGPM312L.Itembyname("L1-"&amp;j), "L1 laukelyje nurodytas neteisingas asmens kodas arba VMI suteiktas mokėtojo numeris")
					end if
					if not isnumeric(fieldsGPM312L.Itembyname("L1-"&amp;j).value) then tmp_2 = true
				end if
				if tmp = false and tmp_2 = true then form.seterror"L1 laukelyje nurodytas neteisingas asmens kodas arba VMI suteiktas mokėtojo numeris", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
				
				if fieldsGPM312L.Itembyname("L2-"&amp;j).todecimal = 1 and isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
					if len(fieldsGPM312L.Itembyname("L1-"&amp;j).value) = 11 then
						tmp =  AK_tikrinimas (fieldsGPM312L.Itembyname("L1-"&amp;j).value, fieldsGPM312L.Itembyname("L1-"&amp;j), "Pasitikrinkite L1 laukelyje įrašytą asmens kodą")
						if tmp then 
							Redim Preserve m1(Ubound(m1)+1)
							set m1(Ubound(m1))=fieldsGPM312L.Itembyname("L1-"&amp;j)
							b2=true
						end if
					end if
				end if
				
				if fieldsGPM312L.Itembyname("L2-"&amp;j).todecimal = 2 then
					if isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
						tmp = false
						tmp = verslo_nr(trim(cstr(fieldsGPM312L.Itembyname("L1-"&amp;j).value)))
						if tmp = false then
						'	form.seterror"L1 laukelyje nurodytas neteisingas verslo liudijimo numeris", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
						'	form.seterror"L1 laukelyje nurodytas neteisingas verslo liudijimo numeris. Pasitikrinkite, verslo liudijime po brūkšnelio įrašytas versijos numeris nepildomas.", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
							form.seterror"L1 laukelyje nurodytas neteisingas verslo liudijimo numeris. Pasitikrinkite, jei įrašėte po brūkšnelio esantį verslo liudijimo versijos numerį - pašalinkite.", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
						end if
					end if
				end if
				
				if fieldsGPM312L.Itembyname("L2-"&amp;j).todecimal = 3 then
					if isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
						tmp = false
						tmp = PVM_kodas(trim(cstr(fieldsGPM312L.Itembyname("L1-"&amp;j).value)))
						if tmp = false then
							form.seterror"L1 laukelyje nurodytas neteisingas  PVM mokėtojo kodas", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
						end if
					end if
				end if
				
				if fieldsGPM312L.Itembyname("L2-"&amp;j).todecimal = 4 then
					if isfilled(fieldsGPM312L.Itembyname("L1-"&amp;j)) then
						tmp = false
					'	tmp = IVPN(trim(cstr(fieldsGPM312L.Itembyname("L1-"&amp;j).value)))	'individualios veiklos pazymos numeris
						tmp = IVPN(fieldsGPM312L.Itembyname("L1-"&amp;j) )	'individualios veiklos pazymos numeris
						if tmp = false then
							form.seterror"L1 laukelyje nurodytas neteisingas individualios veiklos pažymos numeris", array(fieldsGPM312L.Itembyname("L1-"&amp;j))
						end if
					end if
				end if
				
				if isfilled(fieldsGPM312L.Itembyname("L2-"&amp;j)) then
					tmp = false
				'	for each k in array ("1", "2", "3", "4", "5", "6")	'L2 1-5, U1 1-6
					for each k in array ("1", "2", "3", "4", "5")
						if fieldsGPM312L.Itembyname("L2-"&amp;j).value = k then
							tmp = true
							exit for
						end if
					next
					if tmp = false then form.seterror"L2 laukelyje pasirinkta kodo rūšis nepatenka į galimų reikšmių sąrašą", array(fieldsGPM312L.Itembyname("L2-"&amp;j))
				end if
				
			'ork---------
				if isfilled(fieldsGPM312L.Itembyname("L4-"&amp;j)) then
					tmp = false
					for each k in array ("A", "B")
						if fieldsGPM312L.Itembyname("L4-"&amp;j).value = k then
							tmp = true
							exit for
						end if
					next
					if tmp = false then
						form.seterror"L4 laukelyje nurodyta neteisinga išmokų klasė", array(fieldsGPM312L.Itembyname("L4-"&amp;j))
					End If
				End If
				
				if isfilled(fieldsGPM312L.Itembyname("L5-"&amp;j)) then
					dim ismokos
					 
					tmp = false
					if metai = 2018 then
						ismokos = array("01", "02", "03",       "05", "06", "07", "08",       "10", "12", "13", "14", "15", "16", "17", "18", "23", "24", "26", "27", "28", "29", "30", "31", "33", "34", "35", "36", "37", "38", "39", "42", "43", "44",       "46", "47", "48", "51", "52", "55", "56", "58", "59",       "61", "62", "64", "65", "66", "67", "69", "70", "71", "72", "73", "74", "75", "76",             "88",       "92", "93", "94", "95", "96")
					elseif metai = 2019 then
						ismokos = array("01", "02", "03", "04", "05", "06", "07", "08", "09",       "12", "13", "14", "15", "16", "17", "18", "23", "24", "26", "27",       "29", "30", "31", "33", "34", "35", "36", "37", "38", "39", "42", "43", "44", "45", "46", "47", "48", "51", "52", "55", "56", "58", "59", "60", "61", "62", "64", "65", "66", "67", "69", "70", "71",       "73", "74",       "76", "77", "78", "88", "89", "92", "93",             "96")
					elseif metai = 2020 then
