{
 "rules": [
  {
   "id": "R-FIT-WS1A",
   "statement": "Federal income tax: Pub. 15-T 2026 Worksheet 1A, STANDARD schedule, annualise x periods, less line 1g, bracket cumulative tax + excess x rate, / periods, half-up to the cent",
   "lines": [
    "fit"
   ]
  },
  {
   "id": "R-NRA-ADDON",
   "statement": "Nonresident alien: Table 2 add-on added to the wages for the computation only",
   "lines": [
    "fit",
    "net"
   ]
  },
  {
   "id": "R-FICA",
   "statement": "OASDI employee rate x lesser of remaining base and pay; Medicare employee rate x pay",
   "lines": [
    "oasdi",
    "medicare",
    "net"
   ]
  },
  {
   "id": "R-FICA-BASE",
   "statement": "OASDI stops at the annual wage base per employer",
   "lines": [
    "oasdi"
   ]
  },
  {
   "id": "R-ADDL-MEDICARE",
   "statement": "Additional Medicare on wages above the withholding threshold, employee only",
   "lines": [
    "addl_medicare"
   ]
  },
  {
   "id": "R-FUTA",
   "statement": "FUTA net rate on the first wage-base dollars per employee per year",
   "lines": [
    "futa"
   ]
  },
  {
   "id": "R-SUPP-FLAT",
   "statement": "Supplemental wages: optional flat rate",
   "lines": [
    "fit",
    "net"
   ]
  },
  {
   "id": "R-PRETAX-401K",
   "statement": "401(k) elective deferral: reduces federal income-tax withholding wages only (fed.base.401k_deferral.fit/fica/futa, Pub. 15 (2026) sec. 15); FICA and FUTA on the full wages",
   "lines": [
    "fit",
    "oasdi",
    "medicare",
    "futa",
    "net"
   ]
  },
  {
   "id": "R-SUPP-MANDATORY",
   "statement": "Supplemental wages above the mandatory threshold: mandatory rate",
   "lines": [
    "fit",
    "net"
   ]
  },
  {
   "id": "R-MINWAGE",
   "statement": "Gross = hours x FLSA minimum wage",
   "lines": [
    "net"
   ]
  },
  {
   "id": "R-OVERTIME",
   "statement": "Weekly overtime above the threshold at the premium multiplier",
   "lines": [
    "gross"
   ]
  },
  {
   "id": "R-PRORATION",
   "statement": "Monthly salary x working days in service / working days in the month (configuration choice)",
   "lines": [
    "gross"
   ]
  },
  {
   "id": "R-CT-TABLE",
   "statement": "Connecticut: withholding = amount of the CT-W4 code column in the DRS per-period table band (wages greater than the lower bound and not above the upper bound)",
   "lines": [
    "withholding"
   ]
  },
  {
   "id": "R-STATE-ORACLE",
   "statement": "State withholding re-derived from the facts equals the authority's published example",
   "lines": [
    "withholding"
   ]
  },
  {
   "id": "R-PARAM",
   "statement": "Rule parameter of a coverage row read from the facts equals the official value",
   "lines": [
    "value"
   ]
  }
